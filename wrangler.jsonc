{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kanryo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp/*", "/.well-known/*"]
  },
  // npm run setup writes your own database_id here. Setting up by hand: paste the id
  // printed by `npx wrangler d1 create kanryo`. Local dev works with the placeholder.
  "d1_databases": [
    { "binding": "DB", "database_name": "kanryo", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "kanryo-files" }
  ],
  // Workers AI: turns PDF/Office attachments into Markdown when Claude reads them over MCP
  // (toMarkdown). Cloudflare does document conversion for free; nothing to set up.
  "ai": { "binding": "AI" },
  // Login brute-force guard: 5 attempts per minute per IP. namespace_id is any number
  // unique within your account.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
