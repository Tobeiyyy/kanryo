{
  "name": "kanryo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc -b --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply kanryo --local",
    "migrate:remote": "wrangler d1 migrations apply kanryo --remote",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "@tanstack/react-query": "^5.62.0",
    "hono": "^4.13.2",
    "jose": "^6.2.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
